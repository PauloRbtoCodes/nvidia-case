# ---------------------------------------------------------------------------
# NVIDIA Startup AI Radar — copie para .env e preencha
# ---------------------------------------------------------------------------

# NVIDIA NIM — https://build.nvidia.com — botao 'Get API Key' na pagina do modelo.
# Modelos atualizados em 2026-09-09: llama-3.3-70b perdeu o endpoint gratuito e
# llama-3.1-8b / nv-embedqa-e5-v5 foram DEPRECADOS. Os substitutos gratuitos sao
# todos Nemotron — o que, num case para a NVIDIA, e melhor narrativa tambem.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
NIM_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# Modelo pequeno para tarefas mecanicas (planner, validador de evidencia).
# A cota gratuita do NIM e o recurso mais escasso do projeto.
NIM_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Cohere Rerank — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

# Search API para descoberta de startups — https://app.tavily.com
TAVILY_API_KEY=

# Infraestrutura local (docker compose up -d)
DATABASE_URL=postgresql+psycopg://radar:radar@localhost:5432/radar
# Opcional: habilita o teste que prova que JSONB resolve no Postgres real
# (a suite roda em SQLite por padrao e pula esse teste sem esta variavel).
TEST_DATABASE_URL=
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=nvidia_kb

# Langfuse — crie o projeto em http://localhost:3001 e cole as chaves
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# Governanca de cota do LLM (padroes em config.py; descomente para ajustar)
# A cota gratuita do NIM e o recurso mais escasso do projeto — na PRIMEIRA
# execucao real vale baixar o teto para descobrir o custo por empresa antes de
# soltar um lote inteiro.
# LLM_MAX_CONCURRENCY=4
# LLM_MAX_CALLS_PER_RUN=400
# LLM_CACHE_ENABLED=true

# Comportamento do scraping
SCRAPER_USER_AGENT=NVIDIAStartupRadar/0.1 (projeto academico; contato: pr81072045@gmail.com)
SCRAPER_RATE_LIMIT_SECONDS=2.0
SCRAPER_RESPECT_ROBOTS=true
SCRAPER_CACHE_DIR=data/cache
