# ---------------------------------------------------------------------------
# NVIDIA Startup AI Radar — copie para .env e preencha
# ---------------------------------------------------------------------------

# NVIDIA NIM — https://build.nvidia.com (gere a chave no perfil, formato nvapi-...)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_CHAT_MODEL=meta/llama-3.3-70b-instruct
NIM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# Cohere Rerank — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

# Search API para descoberta de startups — https://app.tavily.com
TAVILY_API_KEY=

# Infraestrutura local (docker compose up -d)
DATABASE_URL=postgresql+psycopg://radar:radar@localhost:5432/radar
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=nvidia_kb

# Langfuse — crie o projeto em http://localhost:3001 e cole as chaves
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# Comportamento do scraping
SCRAPER_USER_AGENT=NVIDIAStartupRadar/0.1 (projeto academico; contato: pr81072045@gmail.com)
SCRAPER_RATE_LIMIT_SECONDS=2.0
SCRAPER_RESPECT_ROBOTS=true
SCRAPER_CACHE_DIR=data/cache
